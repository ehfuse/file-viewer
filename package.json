{
    "name": "@ehfuse/file-viewer",
    "version": "0.2.5",
    "type": "module",
    "description": "React 파일 미리보기 다이얼로그 (이미지/PDF/텍스트/코드/HTML/스프레드시트/비디오/오디오, MUI 기반)",
    "publishConfig": {
        "access": "restricted"
    },
    "author": "KIM YOUNG JIN <ehfuse@gmail.com>",
    "license": "MIT",
    "keywords": [
        "react",
        "mui",
        "material-ui",
        "file-viewer",
        "preview",
        "pdf",
        "image",
        "spreadsheet",
        "monaco",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/ehfuse/file-viewer.git"
    },
    "main": "dist/index.js",
    "module": "dist/index.esm.js",
    "types": "dist/index.d.ts",
    "bin": {
        "file-viewer-setup-pdfjs": "./scripts/setup-pdfjs.mjs"
    },
    "files": [
        "dist",
        "scripts",
        "README.md",
        "LICENSE"
    ],
    "sideEffects": false,
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.esm.js",
            "require": "./dist/index.js"
        },
        "./icons": {
            "types": "./dist/icons/index.d.ts",
            "import": "./dist/icons.esm.js",
            "require": "./dist/icons.js"
        },
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "node build.js",
        "type-check": "npx tsc --noEmit",
        "prepare": "npm run build",
        "prepublishOnly": "npm run build"
    },
    "peerDependencies": {
        "@ehfuse/mui-fadeout-loading-progress": ">=1.0.0",
        "@emotion/react": ">=11.0.0",
        "@emotion/styled": ">=11.0.0",
        "@monaco-editor/react": ">=4.6.0",
        "@mui/icons-material": ">=5.0.0",
        "@mui/material": ">=5.0.0",
        "react": "^18.0.0 || ^19.0.0",
        "react-dom": "^18.0.0 || ^19.0.0",
        "react-pdf": ">=9.0.0",
        "react-spreadsheet": ">=0.9.0",
        "xlsx": ">=0.18.0"
    },
    "devDependencies": {
        "@ehfuse/mui-fadeout-loading-progress": "^1.0.4",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@monaco-editor/react": "^4.7.0",
        "@mui/icons-material": "^7.3.4",
        "@mui/material": "^7.3.7",
        "@types/node": "^24.8.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "esbuild": "^0.25.11",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-pdf": "^10.2.0",
        "react-spreadsheet": "^0.10.1",
        "tslib": "^2.8.1",
        "typescript": "^5.9.3",
        "xlsx": "^0.18.5"
    },
    "allowScripts": {
        "esbuild@0.25.12": true
    }
}
